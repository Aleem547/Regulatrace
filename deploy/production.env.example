# Production operator reference. Set real values privately in the hosting service.
# Do not commit a populated copy. Application settings use the REGULATRACE_ prefix.
REGULATRACE_APP_NAME=Regulatrace
REGULATRACE_ENVIRONMENT=production
REGULATRACE_DEBUG=false
REGULATRACE_CORS_ALLOWED_ORIGINS=[]
REGULATRACE_LLM_PROVIDER=groq
REGULATRACE_LLM_MODEL=openai/gpt-oss-120b
REGULATRACE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
REGULATRACE_QDRANT_COLLECTION=regulatrace_chunks
REGULATRACE_BM25_COLLECTION=regulatrace_bm25
REGULATRACE_LANGFUSE_ENABLED=false

# Required secrets: fill in the hosting settings, never in a public repository.
REGULATRACE_JWT_SECRET=
REGULATRACE_GROQ_API_KEY=
REGULATRACE_DATABASE_URL=
REGULATRACE_QDRANT_URL=
REGULATRACE_QDRANT_API_KEY=

# Docker already sets REGULATRACE_FRONTEND_DIST=/app/frontend/dist and PORT=8000.
# For a separate frontend, set explicit HTTPS CORS origins and its public API URL.
