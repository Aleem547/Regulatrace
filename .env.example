# Regulatrace Environment Configuration Example
# Copy this file to .env and adjust values for local development.

# Application metadata
REGULATRACE_APP_NAME="Regulatrace"
REGULATRACE_ENVIRONMENT="development"
REGULATRACE_LOG_LEVEL="INFO"
REGULATRACE_DEBUG=false
# CORS: JSON list of explicit frontend origins; do not use a wildcard.
REGULATRACE_CORS_ALLOWED_ORIGINS='["http://localhost:5173"]'
# Authentication: generate with python -c "import secrets; print(secrets.token_hex(32))".
# Set the generated value locally; never commit the real signing secret.
# REGULATRACE_JWT_SECRET=""

# LLM and Embedding Configuration
# Supported providers: mock, gemini (or google), groq.
REGULATRACE_LLM_PROVIDER="mock"
REGULATRACE_LLM_MODEL="gemini-2.5-flash"
REGULATRACE_EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

# Optional Gemini IPv4 source binding for affected local networks (default: false).
# Gemini SDK requests use a 60,000 ms timeout; this is not a total wall-clock deadline.
REGULATRACE_GEMINI_FORCE_IPV4=false

# Optional GroqCloud alternative: install with python -m pip install -e ".[groq]".
# Uncomment these lines to override the provider/model settings above.
# REGULATRACE_LLM_PROVIDER="groq"
# REGULATRACE_LLM_MODEL="openai/gpt-oss-120b"
# Groq uses a 60-second request timeout with SDK retries disabled.

# Database Configuration (PostgreSQL)
REGULATRACE_DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/regulatrace"

# Qdrant Vector Store
REGULATRACE_QDRANT_URL="http://localhost:6333"
# REGULATRACE_QDRANT_API_KEY=""
REGULATRACE_QDRANT_COLLECTION="regulatrace_chunks"
REGULATRACE_BM25_COLLECTION="regulatrace_bm25"

# Provider API Keys (leave blank or specify in local .env)
# REGULATRACE_GEMINI_API_KEY=""
# REGULATRACE_GROQ_API_KEY=""

# Optional Langfuse tracing: install with python -m pip install -e ".[tracing]".
# SDK v4 on Python 3.10; SDK v5 on Python 3.11+. Disabled by default.
REGULATRACE_LANGFUSE_ENABLED=false
# REGULATRACE_LANGFUSE_PUBLIC_KEY="pk-lf-..."
# REGULATRACE_LANGFUSE_SECRET_KEY="sk-lf-..."
REGULATRACE_LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# Optional cost estimates: set the exact active model and BOTH USD prices per million
# tokens from your provider's applicable tariff. Unset/mismatched pricing => null cost.
# REGULATRACE_LLM_PRICING_MODEL="your-exact-Groq-model-id"
# REGULATRACE_LLM_INPUT_PRICE_PER_MILLION=""
# REGULATRACE_LLM_OUTPUT_PRICE_PER_MILLION=""
